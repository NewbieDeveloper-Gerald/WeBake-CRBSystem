{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/frontend/customer/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/orders/cancel",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/orders/cancel"
    },
    {
      "source": "/api/orders/:orderCode",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/orders/:orderCode"
    },
    {
      "source": "/api/orders",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/orders"
    },
    {
      "source": "/api/products",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/products"
    },
    {
      "source": "/api/products/:path*",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/products/:path*"
    },
    {
      "source": "/api/partner/:path*",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/partner/:path*"
    },
    {
      "source": "/api/health",
      "destination": "https://webake-crbsystem-backend.onrender.com/api/health"
    },
    {
      "source": "/",
      "destination": "/frontend/customer/html/home.html"
    }
  ]
}
