# ====================================================================
# WeBake - Backend Environment Variables Reference (Template)
# Copy these keys into Render.com -> Your Web Service -> Environment
# Replace placeholders with your actual secret credentials.
# ====================================================================

PORT=5000
NODE_ENV=production
# Comma-separated frontend origins; set your deployed Vercel/custom domain on Render.
CLIENT_ORIGIN=*

# Gmail SMTP Credentials (for OTPs and Digital Receipts)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASS=your_16_digit_app_password_here

# Supabase PostgreSQL Database (Transaction Pooler - IPv4/IPv6 Compatible)
DATABASE_URL=postgresql://postgres.your_project_ref:your_password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Granular Database Connection Parameters
DB_USER=postgres.your_project_ref
DB_PASSWORD=your_database_password_here
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_SSL=true
